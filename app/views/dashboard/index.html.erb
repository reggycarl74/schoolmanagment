<% content_for :title, "Dashboard · SchoolOS" %>
<section class="relative overflow-hidden rounded-xl border border-violet-100 bg-gradient-to-r from-white to-violet-100 px-6 py-7 shadow-sm sm:px-8">
  <div class="relative z-10"><p class="text-sm font-black text-violet-700">Welcome to <%= current_school.name %></p><h1 class="mt-1 text-3xl font-black text-slate-950"><%= current_user.teacher? ? "Welcome back, #{current_user.first_name}" : "School Management System" %></h1><p class="mt-2 max-w-2xl text-sm text-slate-600"><%= current_user.teacher? ? "Manage your assigned students, enter scores, prepare lessons, and follow your timetable." : "Manage students, enter scores, generate reports, and run daily school operations easily." %></p></div>
  <div class="absolute -right-8 -top-12 text-[11rem] text-violet-200/50">◆</div>
</section>

<section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <% cards = @statistics.to_a.first(3) + [["published exams", @published_assessments]] %>
  <% icons = ["♟", "◆", "▤", "✓"] %><% colors = ["text-violet-700 bg-violet-100", "text-indigo-700 bg-indigo-100", "text-fuchsia-700 bg-fuchsia-100", "text-emerald-700 bg-emerald-100"] %>
  <% cards.each_with_index do |(name, value), index| %><article class="rounded-xl border border-violet-100 bg-white p-5 shadow-sm"><div class="flex items-center gap-4"><span class="flex h-12 w-12 items-center justify-center rounded-xl text-xl <%= colors[index] %>"><%= icons[index] %></span><div><p class="text-xs font-bold capitalize text-slate-500"><%= name %></p><p class="mt-1 text-3xl font-black text-slate-950"><%= value %></p></div></div></article><% end %>
</section>

<section class="mt-6 grid gap-6 xl:grid-cols-[1.15fr_1fr]">
  <article class="rounded-xl border border-violet-100 bg-white p-6 shadow-sm"><div class="flex items-center justify-between"><h2 class="text-lg font-black text-slate-900">Quick Actions</h2><span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-bold text-violet-700"><%= number_to_percentage(@overall_performance, precision: 1) %> overall</span></div><div class="mt-5 grid gap-3 sm:grid-cols-2"><%= link_to new_exam_result_path, class: "primary-button" do %><span class="mr-2">✎</span>Enter exam scores<% end %><%= link_to academic_report_path, class: "secondary-button" do %><span class="mr-2">▥</span>View results<% end %><%= link_to students_path, class: "secondary-button" do %><span class="mr-2">♟</span>Manage students<% end %><%= link_to classrooms_path, class: "secondary-button" do %><span class="mr-2">◆</span>Manage classes<% end %></div></article>
  <article class="rounded-xl border border-violet-100 bg-white p-6 shadow-sm"><h2 class="text-lg font-black text-slate-900">Recent Activities</h2><div class="mt-5 space-y-4"><% @recent_announcements.each do |announcement| %><div class="flex gap-3"><span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-emerald-500"></span><div><p class="text-sm font-bold text-slate-800"><%= announcement.title %></p><p class="mt-0.5 text-xs text-slate-400"><%= time_ago_in_words(announcement.published_at) %> ago</p></div></div><% end %><% if @recent_announcements.empty? %><p class="text-sm text-slate-500">No recent announcements.</p><% end %></div></article>
</section>
