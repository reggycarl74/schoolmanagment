<% content_for :title, "Academic performance · SchoolOS" %>
<section class="overflow-hidden rounded-xl border border-violet-100 bg-white shadow-sm">
  <div class="bg-gradient-to-r from-violet-800 via-indigo-800 to-violet-700 px-6 py-7 text-white sm:px-8"><p class="text-xs font-black uppercase tracking-[0.22em] text-violet-200">Reports & analytics</p><h1 class="mt-2 text-3xl font-black">Class Performance Report</h1><p class="mt-2 text-sm text-violet-100">Generate class rankings, grades, and performance summaries.</p></div>
  <%= form_with url: academic_report_path, method: :get, class: "grid gap-4 p-5 print:hidden md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] md:items-end sm:p-6" do |form| %><div><%= form.label :classroom_id, "Class", class: "field-label" %><%= form.collection_select :classroom_id, @classrooms, :id, :name, { prompt: "Select class", selected: @classroom&.id }, class: "form-input" %></div><div><%= form.label :term_id, "Term", class: "field-label" %><%= form.select :term_id, options_from_collection_for_select(@classroom&.academic_year&.terms || [], :id, :name, @term&.id), { prompt: "Select term" }, class: "form-input" %></div><%= form.submit "Generate report", class: "primary-button" %><% end %>
</section>

<% if @classroom && @term %>
  <section class="mt-6 overflow-hidden rounded-xl border border-violet-100 bg-white shadow-sm">
    <div class="flex flex-col gap-4 border-b border-violet-100 bg-violet-50/60 px-6 py-5 sm:flex-row sm:items-center sm:justify-between"><div><p class="text-xs font-black uppercase tracking-wider text-violet-600">Results summary</p><h2 class="mt-1 text-xl font-black text-slate-900"><%= @classroom.name %> · <%= @term.name %></h2><p class="mt-1 text-sm text-slate-500">Academic year <%= @classroom.academic_year.name %></p></div><div class="flex flex-wrap gap-2 print:hidden"><%= link_to "Export to CSV", academic_report_path(classroom_id: @classroom.id, term_id: @term.id, format: :csv), class: "inline-flex min-h-10 items-center rounded-lg bg-emerald-50 px-4 text-sm font-bold text-emerald-700 hover:bg-emerald-100" %><button type="button" onclick="window.print()" class="inline-flex min-h-10 items-center rounded-lg bg-violet-700 px-4 text-sm font-bold text-white hover:bg-violet-800">Print report</button></div></div>
    <div class="mx-6 mt-5 flex items-center gap-3 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-800"><span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-600 text-white">✓</span>Results calculated successfully.</div>
    <div class="grid gap-4 p-6 sm:grid-cols-3"><article class="flex items-center gap-4 rounded-xl border border-violet-100 bg-white p-5 shadow-sm"><span class="flex h-12 w-12 items-center justify-center rounded-xl bg-violet-100 text-2xl text-violet-700">♟</span><div><p class="text-xs font-bold text-slate-500">Total Students</p><p class="text-3xl font-black text-slate-950"><%= @summary[:total_students] %></p></div></article><article class="flex items-center gap-4 rounded-xl border border-violet-100 bg-white p-5 shadow-sm"><span class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-100 text-2xl text-amber-700">♛</span><div><p class="text-xs font-bold text-slate-500">Average Score</p><p class="text-3xl font-black text-slate-950"><%= number_to_percentage(@summary[:average_score], precision: 1) %></p></div></article><article class="flex items-center gap-4 rounded-xl border border-violet-100 bg-white p-5 shadow-sm"><span class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100 text-2xl text-indigo-700">★</span><div><p class="text-xs font-bold text-slate-500">Pass Rate</p><p class="text-3xl font-black text-slate-950"><%= number_to_percentage(@summary[:pass_rate], precision: 1) %></p></div></article></div>
    <div class="overflow-x-auto px-6 pb-6"><table class="w-full min-w-[850px] border-collapse text-left"><thead><tr class="bg-violet-950 text-white"><th class="border border-violet-800 px-4 py-3">#</th><th class="border border-violet-800 px-4 py-3">Student Name</th><th class="border border-violet-800 px-4 py-3 text-center">Position</th><th class="border border-violet-800 px-4 py-3 text-center">Exam Score</th><th class="border border-violet-800 px-4 py-3 text-center">Raw Score (100)</th><th class="border border-violet-800 px-4 py-3 text-center">Grade</th><th class="border border-violet-800 px-4 py-3">Remarks</th></tr></thead><tbody><% @rows.each_with_index do |row, index| %><tr><td class="border border-violet-100 px-4 py-3 font-semibold"><%= index + 1 %></td><td class="border border-violet-100 px-4 py-3 font-bold text-slate-900"><%= row[:student].full_name %><span class="mt-0.5 block text-xs font-normal text-slate-400"><%= row[:student].admission_number %></span></td><td class="border border-violet-100 px-4 py-3 text-center font-bold"><%= (index + 1).ordinalize %></td><td class="border border-violet-100 px-4 py-3 text-center"><%= number_with_precision(row[:earned], precision: 2, strip_insignificant_zeros: true) %> / <%= number_with_precision(row[:possible], precision: 2, strip_insignificant_zeros: true) %></td><td class="border border-violet-100 px-4 py-3 text-center font-black text-violet-700"><%= number_with_precision(row[:percentage], precision: 2) %></td><td class="border border-violet-100 px-4 py-3 text-center"><span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-black text-emerald-700"><%= row[:grade] %></span></td><td class="border border-violet-100 px-4 py-3"><span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-bold text-violet-700"><%= row[:remark] %></span></td></tr><% end %></tbody></table><% if @rows.empty? %><div class="rounded-b-xl border border-t-0 border-violet-100 px-6 py-12 text-center text-sm text-slate-500">No published results are available for <%= @classroom.name %> in <%= @term.name %>.</div><% end %></div>
  </section>
<% else %>
  <div class="mt-6 rounded-xl border-2 border-dashed border-violet-200 bg-white px-6 py-14 text-center"><p class="text-lg font-black text-slate-800">Select a class and term</p><p class="mt-2 text-sm text-slate-500">Choose the report details above to generate the results summary.</p></div>
<% end %>
