<% if current_user.administrator? %>
  <% navigation_groups = [["Main", [["Dashboard", "⌂", root_path]]], ["People", [["Students", "♟", students_path], ["Guardians", "♙", guardians_path], ["Teachers", "♜", teachers_path]]], ["Academics", [["Classes", "◆", classrooms_path], ["Subjects", "▣", subjects_path], ["Teacher assignments", "⇄", teaching_assignments_path], ["Lesson plans", "▤", lesson_notes_path], ["Enter results", "✓", new_exam_result_path], ["Assessment workflow", "☷", assessments_path], ["Academic reports", "▥", academic_report_path], ["Teacher remarks", "✎", report_card_remark_templates_path]]], ["Operations", [["Attendance", "◫", attendance_register_path], ["Attendance analytics", "▥", attendance_analytics_path], ["Timetable", "◷", timetable_entries_path], ["Announcements", "◉", announcements_path], ["SMS configuration", "✉", sms_setting_path], ["Fee structures", "◇", fee_structures_path], ["Billing", "▧", invoices_path], ["Financial report", "▥", financial_report_path]]], ["Administration", [["Users & passwords", "♟", admin_users_path], ["School settings", "⚙", school_setting_path], ["Assessment settings", "☷", assessment_settings_path], ["Promotions", "↑", new_promotion_path], ["Year rollover", "↻", new_academic_year_rollover_path], ["Audit log", "≡", audit_events_path]]]] %>
<% elsif current_user.teacher? %>
  <% navigation_groups = [["Main", [["Dashboard", "⌂", root_path]]], ["My Students", [["Student list", "♟", students_path], ["My classes", "◆", classrooms_path], ["Promote students", "↑", new_promotion_path]]], ["Teaching", [["My subjects", "▣", subjects_path], ["Classroom", "▤", classroom_posts_path], ["Enter results", "✓", new_exam_result_path], ["Lesson plans", "✎", lesson_notes_path]]], ["Assessment", [["Assessment workflow", "☷", assessments_path], ["Academic reports", "▥", academic_report_path], ["Teacher remarks", "✎", report_card_remark_templates_path], ["Attendance analytics", "▥", attendance_analytics_path]]], ["Schedule", [["Take attendance", "◫", attendance_register_path], ["My timetable", "◷", timetable_entries_path], ["School news", "◉", announcements_path]]]] %>
<% elsif current_user.registrar? %>
  <% navigation_groups = [["Main", [["Dashboard", "⌂", root_path]]], ["People", [["Students", "♟", students_path], ["Guardians", "♙", guardians_path]]], ["Academics", [["Classes", "◆", classrooms_path], ["Subjects", "▣", subjects_path], ["Results", "✓", new_exam_result_path]]], ["Operations", [["Attendance", "◫", attendance_register_path], ["Analytics", "▥", attendance_analytics_path], ["Timetable", "◷", timetable_entries_path], ["Announcements", "◉", announcements_path]]]] %>
<% elsif current_user.accountant? %>
  <% navigation_groups = [["Main", [["Dashboard", "⌂", root_path]]], ["Students", [["Student directory", "♟", students_path]]], ["Billing", [["Fee structures", "◇", fee_structures_path], ["Invoices & payments", "▧", invoices_path], ["New invoice", "+", new_invoice_path]]], ["Reports", [["Financial report", "▥", financial_report_path]]], ["School", [["Announcements", "◉", announcements_path]]]] %>
<% else %>
  <% profile_links = current_user.student? && current_user.student ? [["Portal", "⌂", family_portal_path], ["My profile", "♟", student_path(current_user.student)], ["My classroom", "▤", classroom_posts_path], ["My assessments", "✓", assessments_student_path(current_user.student)]] : [["Family dashboard", "⌂", family_portal_path], ["My children", "♟", students_path]] %>
  <% navigation_groups = [["Profile", profile_links], ["Academics", [["Assessments", "✓", (current_user.student? && current_user.student ? assessments_student_path(current_user.student) : students_path)]]], ["Finance", [["Billing", "▧", invoices_path]]], ["School", [["Announcements", "◉", announcements_path]]]] %>
<% end %>

<% navigation_groups.each do |label, links| %>
  <section class="mb-5"><p class="mb-2 px-3 text-[10px] font-black uppercase tracking-[0.2em] text-violet-400"><%= label %></p><div class="space-y-1"><% links.each do |link_label, icon, path| %><%= link_to path, class: "flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-semibold transition #{current_page?(path) ? 'bg-violet-600 text-white shadow-lg shadow-violet-950/30' : 'text-violet-100 hover:bg-white/10 hover:text-white'}", data: { action: "mobile-menu#close" } do %><span class="flex w-5 justify-center text-base"><%= icon %></span><span><%= link_label %></span><% end %><% end %></div></section>
<% end %>

<div class="mt-6 border-t border-white/10 pt-4"><%= link_to edit_profile_path, class: "flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-semibold text-violet-100 hover:bg-white/10" do %><span>⚙</span><span>Edit profile</span><% end %><%= button_to session_path, method: :delete, class: "mt-1 flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-violet-100 hover:bg-red-500/20 hover:text-white" do %><span>↪</span><span>Logout</span><% end %><div class="mt-4 flex items-center gap-3 px-3"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/15 text-xs font-black"><%= current_user.first_name.first %><%= current_user.last_name.first %></span><span class="min-w-0"><strong class="block truncate text-xs"><%= current_user.full_name %></strong><small class="text-[10px] text-violet-300"><%= current_user.role.humanize %></small></span></div></div>
