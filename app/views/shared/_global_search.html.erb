<%= form_with url: search_path, method: :get, class: "relative", role: "search" do |form| %><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-violet-400">⌕</span><%= form.search_field :q, value: params[:q], placeholder: "Search students, classes, invoices...", autocomplete: "off", class: "h-11 w-full rounded-lg border border-violet-100 bg-violet-50/60 pl-9 pr-4 text-sm font-medium text-slate-700 outline-none transition focus:border-violet-400 focus:bg-white focus:ring-4 focus:ring-violet-100" %><% end %>
