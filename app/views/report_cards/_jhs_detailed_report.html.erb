<article class="mx-auto mt-5 max-w-5xl overflow-hidden rounded-2xl border border-violet-200 bg-white shadow-lg print:border-0 print:shadow-none">
  <header class="bg-gradient-to-r from-indigo-950 via-violet-900 to-indigo-800 px-8 py-7 text-white"><%= render "report_cards/report_header" %><p class="mt-3 text-center text-sm font-bold uppercase tracking-[0.25em] text-violet-200">JHS Student Performance Report</p></header>
  <div class="grid gap-4 bg-violet-50 px-6 py-5 sm:grid-cols-4"><div><p class="text-xs font-bold uppercase text-violet-500">Class</p><p class="font-black text-indigo-950"><%= @classroom&.name || "—" %></p></div><div><p class="text-xs font-bold uppercase text-violet-500">Academic year</p><p class="font-black text-indigo-950"><%= @term&.academic_year&.name || "—" %></p></div><div><p class="text-xs font-bold uppercase text-violet-500">Term</p><p class="font-black text-indigo-950"><%= @term&.name || "—" %></p></div><div><p class="text-xs font-bold uppercase text-violet-500">Overall average</p><p class="text-xl font-black text-violet-700"><%= number_to_percentage(@overall_average, precision: 1) %></p></div></div>
  <div class="overflow-x-auto p-6"><table class="w-full min-w-[760px] border-collapse text-sm"><thead><tr class="bg-indigo-950 text-white"><th class="border border-indigo-800 p-3 text-left">Subject</th><th class="border border-indigo-800 p-3">Class score (30)</th><th class="border border-indigo-800 p-3">Exam score (70)</th><th class="border border-indigo-800 p-3">Total (100)</th><th class="border border-indigo-800 p-3">Grade</th><th class="border border-indigo-800 p-3 text-left">Remarks</th></tr></thead><tbody><% @subject_results.each_with_index do |row, index| %><tr class="<%= index.even? ? 'bg-violet-50/60' : 'bg-white' %>"><td class="border border-violet-200 p-3 font-bold text-indigo-950"><%= row[:subject].name %></td><td class="border border-violet-200 p-3 text-center"><%= row[:continuous_score] %></td><td class="border border-violet-200 p-3 text-center"><%= row[:exam_score] %></td><td class="border border-violet-200 p-3 text-center font-black"><%= row[:total_percentage] %></td><td class="border border-violet-200 p-3 text-center"><span class="rounded-full bg-emerald-100 px-3 py-1 font-black text-emerald-700"><%= row[:jhs_scale]&.letter || "—" %></span></td><td class="border border-violet-200 p-3"><%= row[:jhs_scale]&.remark || "—" %></td></tr><% end %></tbody></table></div>
  <div class="px-6 pb-6"><%= render "report_cards/combined_score_summary" %><%= render "report_cards/report_footer" %></div>
</article>
