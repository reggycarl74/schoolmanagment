<section class="mt-7 overflow-hidden rounded-xl border-2 border-violet-200 bg-white text-slate-900">
  <div class="bg-violet-950 px-5 py-3 text-white"><h3 class="font-black">Combined score for all subjects</h3><p class="text-xs text-violet-200"><%= @subject_results.size %> subject<%= "s" unless @subject_results.one? %> combined into a raw score out of 100</p></div>
  <div class="grid gap-4 p-5 sm:grid-cols-4"><div><p class="text-xs font-bold uppercase text-slate-400">Total earned</p><p class="mt-1 text-xl font-black"><%= number_with_precision(@combined_result[:earned], precision: 2, strip_insignificant_zeros: true) %></p></div><div><p class="text-xs font-bold uppercase text-slate-400">Total possible</p><p class="mt-1 text-xl font-black"><%= number_with_precision(@combined_result[:possible], precision: 2, strip_insignificant_zeros: true) %></p></div><div><p class="text-xs font-bold uppercase text-slate-400">Raw score</p><p class="mt-1 text-xl font-black text-violet-700"><%= number_to_percentage(@combined_result[:raw_score], precision: 2) %></p></div><div><p class="text-xs font-bold uppercase text-slate-400">Overall grade</p><p class="mt-1 text-xl font-black"><%= @combined_result[:grade] %></p><p class="text-xs text-slate-500"><%= @combined_result[:remark] %></p></div></div>
</section>
