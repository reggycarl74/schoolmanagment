<% if @term && (current_user.teacher? || current_user.administrator? || current_user.registrar?) %>
  <%= form_with model: ReportCardComment.new, class: "mx-auto mt-8 max-w-5xl overflow-hidden rounded-2xl border border-indigo-200 bg-white shadow-sm print:hidden", data: { controller: "remark-picker" } do |form| %>
    <%= form.hidden_field :student_id, value: @student.id %><%= form.hidden_field :term_id, value: @term.id %>
    <div class="bg-gradient-to-r from-indigo-700 to-violet-700 px-6 py-5 text-white"><p class="text-xs font-bold uppercase tracking-widest text-indigo-200">Teacher workspace</p><h3 class="mt-1 text-xl font-bold">Add or update a report remark</h3></div>
    <div class="space-y-5 p-6"><div><%= label_tag :remark_template, "Choose a saved remark", class: "field-label" %><%= select_tag :remark_template, options_for_select(@remark_templates.map { |template| [template.title, template.id, { data: { body: template.body, kind: template.kind } }] }), include_blank: "Choose a remark or start from scratch", class: "form-input", data: { remark_picker_target: "select", action: "change->remark-picker#choose" } %></div><div class="grid gap-5 md:grid-cols-4"><div><%= form.label :kind, "Category", class: "field-label" %><%= form.select :kind, @comment_kinds.map { |kind| [kind.humanize, kind] }, {}, class: "form-input", data: { remark_picker_target: "kind" } %></div><div class="md:col-span-3"><%= form.label :body, "Personalize for #{@student.first_name}", class: "field-label" %><%= form.text_area :body, required: true, rows: 4, class: "form-input", data: { remark_picker_target: "body" } %></div></div><div class="text-right"><%= form.submit "Save report-card remark", class: "primary-button" %></div></div>
  <% end %>
<% end %>
