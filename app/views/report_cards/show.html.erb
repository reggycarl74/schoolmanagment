<% if @report_template == "classic" %>
  <%= render "report_cards/classic_legacy_report" %>
<% else %>
  <% content_for :title, "Report card · SchoolOS" %>
  <div class="flex flex-col gap-4 print:hidden sm:flex-row sm:items-end sm:justify-between">
    <%= link_to "← Student assessments", assessments_student_path(@student), class: "text-sm font-semibold text-indigo-700" %>
    <%= form_with url: report_card_path(@student), method: :get, class: "flex w-full items-end gap-3 sm:w-auto" do |form| %>
      <div class="min-w-64"><%= form.label :term_id, "Report-card term", class: "field-label" %><%= form.select :term_id, options_for_select(@terms.sort_by(&:starts_on).reverse.map { |term| ["#{term.academic_year.name} · #{term.name}", term.id] }, @term&.id), {}, class: "form-input" %></div>
      <%= form.submit "View", class: "primary-button" %>
    <% end %>
  </div>
  <div class="mt-4 flex items-center justify-between rounded-xl border border-indigo-100 bg-indigo-50 px-4 py-3 print:hidden"><p class="text-sm text-indigo-950"><strong><%= @classroom&.name %></strong> uses the <strong><%= @report_template.humanize %></strong> report form.</p><% if current_user.administrator? && @classroom %><%= link_to "Change report form", edit_classroom_path(@classroom), class: "text-sm font-bold text-indigo-700" %><% end %></div>
  <%= render "report_cards/#{@report_template}_report" %>
  <%= render "report_cards/remark_workspace" %>
  <div class="mx-auto mt-6 max-w-5xl print:hidden"><button onclick="window.print()" class="primary-button">Print / Save PDF</button></div>
<% end %>
