<div class="mt-7 grid grid-cols-2 gap-3 rounded-xl bg-slate-50 p-4 text-sm text-slate-900"><% AttendanceRecord.statuses.each_key do |status| %><p><strong><%= status.humanize %>:</strong> <%= @attendance[status] || 0 %></p><% end %></div>
<% if @comments.any? %><section class="mt-7 text-slate-900"><h3 class="font-black">Teacher remarks</h3><% @comments.each do |comment| %><div class="mt-2 border-b pb-2"><p><%= comment.body %></p><p class="text-xs text-slate-500"><%= comment.kind.humanize %> · <%= comment.author.full_name %></p></div><% end %></section><% end %>
<% if @term %><div class="mt-7 rounded-xl border-2 border-indigo-200 bg-indigo-50 p-4 text-center text-slate-900"><p class="text-xs font-bold uppercase text-indigo-700">School reopens</p><p class="text-lg font-black text-indigo-950"><%= @term.reopening_date&.to_fs(:long) || "Reopening date has not been set" %></p></div><% end %>
