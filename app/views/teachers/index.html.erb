<% content_for :title, "Teachers · SchoolOS" %>
<%= render "shared/section_header", title: "Teachers", subtitle: "Teaching staff, accounts, classes, and subject assignments", button_text: "Add teacher", button_path: new_teacher_path %>

<section class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <% cards = [["Total teachers", @statistics[:total], "♜", "bg-violet-100 text-violet-700"], ["Active staff", @statistics[:active], "✓", "bg-emerald-100 text-emerald-700"], ["Portal accounts", @statistics[:portal_accounts], "♟", "bg-indigo-100 text-indigo-700"], ["Need assignments", @statistics[:unassigned], "!", "bg-amber-100 text-amber-700"]] %>
  <% cards.each do |label, value, icon, colors| %><article class="rounded-xl border border-violet-100 bg-white p-5 shadow-sm"><div class="flex items-center gap-4"><span class="flex h-12 w-12 items-center justify-center rounded-xl text-xl font-black <%= colors %>"><%= icon %></span><div><p class="text-xs font-bold text-slate-500"><%= label %></p><p class="mt-1 text-3xl font-black text-slate-950"><%= value %></p></div></div></article><% end %>
</section>

<section class="mt-6 rounded-xl border border-violet-100 bg-white shadow-sm">
  <div class="flex flex-col gap-4 border-b border-violet-100 p-5 sm:flex-row sm:items-end sm:justify-between">
    <%= form_with url: teachers_path, method: :get, class: "flex w-full max-w-xl flex-col gap-3 sm:flex-row sm:items-end", role: "search" do |form| %><div class="flex-1"><%= form.label :q, "Search teachers", class: "field-label" %><%= form.search_field :q, value: params[:q], placeholder: "Name, email, or employee number", class: "form-input" %></div><%= form.submit "Search", class: "primary-button" %><% if params[:q].present? %><%= link_to "Clear", teachers_path, class: "secondary-button" %><% end %><% end %>
    <%= link_to "Manage assignments →", teaching_assignments_path, class: "shrink-0 text-sm font-black text-violet-700 hover:text-violet-900" %>
  </div>

  <% if @records.any? %>
    <div class="grid gap-4 p-5 lg:grid-cols-2 2xl:grid-cols-3">
      <% @records.each do |teacher| %>
        <article class="overflow-hidden rounded-xl border border-violet-100 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
          <div class="flex items-start gap-4 border-b border-violet-100 bg-violet-50/40 p-5"><span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-violet-800 text-lg font-black text-white"><%= teacher.first_name.first %><%= teacher.last_name.first %></span><div class="min-w-0 flex-1"><div class="flex items-start justify-between gap-2"><div><h2 class="truncate text-lg font-black text-slate-900"><%= teacher.full_name %></h2><p class="text-xs font-bold text-violet-600"><%= teacher.employee_number %></p></div><span class="rounded-full px-2.5 py-1 text-[10px] font-black uppercase <%= teacher.active? ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-600' %>"><%= teacher.active? ? "Active" : "Inactive" %></span></div><p class="mt-2 truncate text-sm text-slate-500"><%= teacher.email.presence || "No email address" %></p><p class="mt-0.5 text-sm text-slate-500"><%= teacher.phone.presence || "No phone number" %></p></div></div>
          <div class="space-y-4 p-5">
            <div><p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Assigned classes</p><div class="mt-2 flex flex-wrap gap-2"><% teacher.assigned_classrooms.distinct.each do |classroom| %><span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700"><%= classroom.name %></span><% end %><% teacher.homeroom_classrooms.each do |classroom| %><span class="rounded-full bg-fuchsia-50 px-3 py-1 text-xs font-bold text-fuchsia-700"><%= classroom.name %> · Homeroom</span><% end %><% if teacher.assigned_classrooms.empty? && teacher.homeroom_classrooms.empty? %><span class="text-sm text-slate-400">No assigned classes</span><% end %></div></div>
            <div><p class="text-[10px] font-black uppercase tracking-wider text-slate-400">Subjects</p><div class="mt-2 flex flex-wrap gap-2"><% teacher.assigned_subjects.distinct.each do |subject| %><span class="rounded-full border border-violet-100 bg-white px-3 py-1 text-xs font-semibold text-slate-600"><%= subject.name %></span><% end %><% if teacher.assigned_subjects.empty? %><span class="text-sm text-slate-400">No assigned subjects</span><% end %></div></div>
            <div class="flex items-center justify-between border-t border-violet-100 pt-4"><span class="text-xs font-bold <%= teacher.user ? 'text-emerald-700' : 'text-amber-700' %>"><%= teacher.user ? "Portal account connected" : "No portal account" %></span><%= link_to "Assign class", new_teaching_assignment_path(teacher_id: teacher.id), class: "text-sm font-black text-violet-700 hover:text-violet-900" %></div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="px-6 py-16 text-center"><p class="text-lg font-black text-slate-800">No teachers found</p><p class="mt-2 text-sm text-slate-500"><%= params[:q].present? ? "No staff match “#{params[:q]}”. Clear the search and try again." : "Add the first teacher to begin assigning classes and subjects." %></p><% if params[:q].present? %><%= link_to "Clear search", teachers_path, class: "primary-button mt-5" %><% end %></div>
  <% end %>
</section>
