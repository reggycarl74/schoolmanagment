<% content_for :title, "Assign teacher · SchoolOS" %>
<%= render "shared/form_header", title: "Assign teacher", back_path: teaching_assignments_path %>
<%= form_with model: @assignment, class: "mx-auto max-w-3xl space-y-6 rounded-2xl border border-slate-200 bg-white p-8 shadow-sm" do |form| %><%= render "shared/form_errors", object: @assignment %><div class="rounded-xl bg-indigo-50 p-4 text-sm font-semibold text-indigo-800">Select several subjects to assign them together. Assignments apply to every term until an administrator changes them.</div><div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :teacher_id, class: "field-label" %><%= form.collection_select :teacher_id, @teachers, :id, :full_name, { prompt: "Select teacher", selected: @assignment.teacher_id }, { required: true, class: "form-input" } %></div><div><%= form.label :classroom_id, "Class", class: "field-label" %><%= form.collection_select :classroom_id, @classrooms, :id, :name, { prompt: "Select class" }, { required: true, class: "form-input" } %></div></div><fieldset><legend class="field-label">Subjects</legend><p class="mt-1 text-xs text-slate-500">Choose every subject this teacher handles for the selected class.</p><div class="mt-3 grid gap-3 sm:grid-cols-2"><% @subjects.each do |subject| %><label class="flex cursor-pointer items-center gap-3 rounded-xl border border-violet-100 bg-violet-50/30 p-4 text-sm font-bold text-slate-700 hover:border-violet-300"><%= check_box_tag "teaching_assignment[subject_ids][]", subject.id, false %><span><%= subject.name %></span></label><% end %></div></fieldset><label class="flex items-center gap-3 text-sm font-medium text-slate-700"><%= form.check_box :lead, checked: true, class: "size-4 rounded border-slate-300 text-indigo-700" %>Lead teacher for the selected subjects</label><%= form.submit "Save subject assignments", class: "primary-button" %><% end %>
